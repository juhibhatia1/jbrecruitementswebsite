// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  sourcePath String?
  referrer   String?
  ipAddress  String?
  userAgent  String?
  browser    String?
  os         String?
  deviceType String?
  country    String?
  region     String?
  city       String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model JobSeekerSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  location         String?
  description      String?
  resumeUrl        String?
  resumeFileName   String?
  sourcePath       String?
  referrer         String?
  ipAddress        String?
  userAgent        String?
  browser          String?
  os               String?
  deviceType       String?
  country          String?
  region           String?
  city             String?
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Purchase {
  id                    String   @id @default(cuid())
  candidateName         String
  candidateEmail        String
  candidatePhone        String?
  serviceName           String
  amount                Float
  currency              String   @default("USD")
  stripePaymentIntentId String   @unique
  status                String   // "PENDING", "COMPLETED", "FAILED"
  country               String?
  mockInterviewStatus   String?  // "PENDING_SCHEDULE", "SCHEDULED", "COMPLETED"
  mockInterviewDate     DateTime?
  deliveryStatus        String   @default("PENDING") // "PENDING", "COMPLETED"
  deliveryDeadline      DateTime?
  completionNotes       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  application           CandidateApplication?

  @@index([candidateEmail])
  @@index([createdAt])
}

model FunnelEvent {
  id          String   @id @default(cuid())
  serviceName String
  eventType   String   // "VIEW", "CLICK_BUY", "COMPLETED"
  createdAt   DateTime @default(now())

  @@index([serviceName])
  @@index([eventType])
  @@index([createdAt])
}

model KnowledgeDocument {
  id          String           @id @default(cuid())
  title       String
  content     String           // raw text content
  sourceType  String           // "UPLOAD_PDF", "UPLOAD_DOCX", "UPLOAD_TEXT", "UPLOAD_MD", "SYSTEM"
  fileName    String?          // original filename if uploaded
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]

  @@index([isActive])
  @@index([createdAt])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  content    String            // chunk text
  embedding  Unsupported("vector(384)") // pgvector column for 384-dimensional embeddings
  chunkIndex Int
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ChatConversation {
  id        String   @id @default(cuid())
  sessionId String   @unique // anonymous browser session ID
  messages  Json     // array of {role, content, timestamp}
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([createdAt])
}

enum InterviewTemplateOwnerRole {
  ADMIN
  EMPLOYEE
}

enum CandidateInterviewPreference {
  AI
  MANUAL
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum CandidateApplicationStatus {
  APPLIED
  MANUAL_REVIEW_PENDING
  SCHEDULED
  AI_INVITED
  INTERVIEW_STARTED
  INTERVIEW_COMPLETED
  TOKEN_EXPIRED
  CANCELLED
}

enum InterviewSessionStatus {
  CONNECTING
  ACTIVE
  COMPLETED
  TERMINATED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  fullName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, isActive])
  @@index([createdAt])
}

model InterviewTemplate {
  id                   String                    @id @default(cuid())
  ownerRole            InterviewTemplateOwnerRole
  jobRole              String
  experienceLevel      String
  techStack            String[]
  requiredSkills       String[]
  durationMinutes      Int
  difficultyLevel      String
  advancedConfig       Json?
  interviewDescription String?
  systemInstructions   String?
  isActive             Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  applications         CandidateApplication[]

  @@index([ownerRole, createdAt])
  @@index([isActive, createdAt])
}

model CandidateApplication {
  id                  String                       @id @default(cuid())
  templateId          String
  candidateName       String
  candidateEmail      String
  candidatePhone      String?
  linkedInUrl         String?
  resumeUrl           String?
  resumeText          String?
  careerGoal          String?
  focusAreas          String?
  selfIntroNotes      String?
  yearsOfExperience   String?
  jobApplicationLink  String?
  interviewPreference CandidateInterviewPreference
  accessTokenHash     String                       @unique
  accessTokenExpiresAt DateTime
  status              CandidateApplicationStatus   @default(APPLIED)
  scheduledAt         DateTime?
  purchaseId          String?                      @unique
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  template            InterviewTemplate            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  session             InterviewSession?
  purchase            Purchase?                    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([candidateEmail])
  @@index([status, accessTokenExpiresAt])
}

model InterviewSession {
  id               String                 @id @default(cuid())
  applicationId    String                 @unique
  provider         String
  modelUsed        String?
  status           InterviewSessionStatus @default(CONNECTING)
  transcript       Json
  evaluationEvents Json
  finalReport      Json?
  referenceCards   Json                   @default("[]")
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  application      CandidateApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([completedAt])
}

