// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  sourcePath String?
  referrer   String?
  ipAddress  String?
  userAgent  String?
  browser    String?
  os         String?
  deviceType String?
  country    String?
  region     String?
  city       String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model JobSeekerSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  location         String?
  description      String?
  resumeUrl        String?
  resumeFileName   String?
  sourcePath       String?
  referrer         String?
  ipAddress        String?
  userAgent        String?
  browser          String?
  os               String?
  deviceType       String?
  country          String?
  region           String?
  city             String?
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Purchase {
  id                    String   @id @default(cuid())
  candidateName         String
  candidateEmail        String
  serviceName           String
  amount                Float
  currency              String   @default("USD")
  stripePaymentIntentId String   @unique
  status                String   // "PENDING", "COMPLETED", "FAILED"
  country               String?
  mockInterviewStatus   String?  // "PENDING_SCHEDULE", "SCHEDULED", "COMPLETED"
  mockInterviewDate     DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([candidateEmail])
  @@index([createdAt])
}

model FunnelEvent {
  id          String   @id @default(cuid())
  serviceName String
  eventType   String   // "VIEW", "CLICK_BUY", "COMPLETED"
  createdAt   DateTime @default(now())

  @@index([serviceName])
  @@index([eventType])
  @@index([createdAt])
}

