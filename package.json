    "@stripe/stripe-js": "^9.8.0",
    "@vercel/analytics": "^1.6.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "imagekit": "^6.0.0",
    "lenis": "^1.3.16",
    "mammoth": "^1.7.2",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
